# ==============================================================================
# .gitignore - PhD Thesis project
# ==============================================================================

# --- R session state ---------------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.R.Rout
*.Rcheck/

# --- Quarto / rendering ------------------------------------------------------
.quarto/
**/_files/
**/*_files/
**/_freeze/
04_thesis/_book/

# Build artefacts that may appear next to qmds
**/*.html
**/*.pdf
**/*.docx
**/*.docx.md
**/*.html.md
**/*.tex
**/Thesis.tex

# Keep CSL and TeX header sources
!04_thesis/apa-with-abstract.csl
!04_thesis/header.tex
!04_thesis/pdf-frontmatter.tex

# --- renv --------------------------------------------------------------------
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/staging/

# --- OS / editor noise -------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/

# --- Other -------------------------------------------------------------------
tinytable_assets/
_tmp_*/

# --- Claude Code -------------------------------------------------------------
.claude/worktrees/
.claude/local/
