# ==============================================================================
# .gitignore - PhD Thesis project
# ==============================================================================

# --- R session state ---------------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.R.Rout
*.Rcheck/

# --- Quarto / rendering ------------------------------------------------------
.quarto/
**/_files/
**/*_files/
04_thesis/_book/

# Track 04_thesis/_freeze/ in git so the cache survives across machines.
# (Quarto upstream recommends committing this directory.)

# Build artefacts that may appear next to qmds
**/*.html
**/*.pdf
**/*.docx
**/*.docx.md
**/*.html.md
**/*.tex
**/Thesis.tex

# Keep CSL and TeX header sources
!04_thesis/apa-with-abstract.csl
!04_thesis/header.tex
!04_thesis/pdf-frontmatter.tex

# --- renv --------------------------------------------------------------------
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/staging/

# --- OS / editor noise -------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/

# --- Other -------------------------------------------------------------------
tinytable_assets/
_tmp_*/

# --- Claude Code -------------------------------------------------------------
# Ignore the entire Claude Code working directory (settings, lockfiles,
# worktrees, transcripts, etc.). These are local/per-machine and should
# not be tracked.
.claude/
CLAUDE.md
.claudeignore

# CSV byproduct that 05_output_returns_rus.R emits but no qmd reads
03_output/returns_outputs/edu_ncs_fig.csv
